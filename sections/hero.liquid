<section class="hero{% if section.settings.image != blank %} hero--image{% endif %}" id="hero-{{ section.id }}">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow reveal"><span class="dot"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title reveal">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hero__text reveal">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="btn-row reveal">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="stats reveal">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value }}</strong>
              <span>{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__media reveal">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      {%- else -%}
        <div class="hero__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Nueva colección 2026" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Diseño que se siente tan bien como se ve" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Productos esenciales, materiales premium y envío rápido a todo el país. Descubrí por qué miles de clientes ya nos eligen." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button_2_label", "label": "Botón secundario", "default": "Conocé más" },
    { "type": "url", "id": "button_2_link", "label": "Enlace del botón secundario" },
    { "type": "image_picker", "id": "image", "label": "Imagen" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "10k+" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "Clientes felices" }
      ]
    }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }] }]
}
{% endschema %}

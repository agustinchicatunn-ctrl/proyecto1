{%- if section.settings.show and section.settings.text != blank -%}
  <div class="announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }} &rarr;</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Mostrar", "default": true },
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis en compras superiores a $50.000" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ]
}
{% endschema %}

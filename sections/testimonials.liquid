<section class="section section--surface" id="opiniones">
  <div class="container">
    <div class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <figure class="testimonial reveal" {{ block.shopify_attributes }}>
          <div class="stars" aria-label="{{ block.settings.rating }} de 5 estrellas">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <figcaption>
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.detail != blank -%}<span class="muted">{{ block.settings.detail }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Opiniones" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen nuestros clientes" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Opinión", "default": "La calidad superó mis expectativas. Llegó rapidísimo y la atención fue excelente." },
        { "type": "text", "id": "author", "label": "Nombre", "default": "Cliente verificado" },
        { "type": "text", "id": "detail", "label": "Detalle", "default": "Compra verificada" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonios", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }]
}
{% endschema %}

<section class="section" id="newsletter">
  <div class="container">
    <div class="cta reveal">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', id: 'newsletter-form', class: 'cta__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-success" role="status">¡Gracias por suscribirte!</p>
        {%- else -%}
          <label class="visually-hidden" for="newsletter-email">Correo electrónico</label>
          <input id="newsletter-email" type="email" name="contact[email]" placeholder="tu@email.com" autocomplete="email" required>
          <button class="btn btn--light" type="submit">{{ section.settings.button_label }}</button>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Novedades por correo" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Te avisamos por correo cuando llegan productos nuevos o hay promociones." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Suscribirme" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

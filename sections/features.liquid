<section class="section" id="beneficios">
  <div class="container">
    <div class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="features">
      {%- for block in section.blocks -%}
        <article class="feature reveal" {{ block.shopify_attributes }}>
          <span class="feature__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Por qué elegirnos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que esperás, y un poco más" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícono (emoji)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Título", "default": "Calidad premium" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Materiales seleccionados y controles de calidad en cada pieza." }
      ]
    }
  ],
  "presets": [{ "name": "Beneficios", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}

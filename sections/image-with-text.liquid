<section class="section" id="historia">
  <div class="container split{% if section.settings.image_right %} split--reverse{% endif %}">
    <div class="split__media reveal">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__content reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte muted">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "image_right", "label": "Imagen a la derecha", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Nuestra historia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hecho con propósito, desde el primer boceto" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Empezamos con una idea simple: crear productos que usarías todos los días y que duren años. Cada detalle está pensado para vos.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Conocé la marca" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Imagen con texto" }]
}
{% endschema %}

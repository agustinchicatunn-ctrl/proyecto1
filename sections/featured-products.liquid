<section class="section" id="productos">
  <div class="container">
    <div class="section__head section__head--row reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">Ver todo &rarr;</a>
      {%- endif -%}
    </div>
    <div class="grid grid--products">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          {% render 'product-card' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Los más vendidos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Favoritos de nuestros clientes" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}

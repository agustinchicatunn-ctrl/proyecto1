<section class="password">
  <div class="container container--narrow center">
    <p class="logo-text">{{ shop.name }}</p>
    <h1>Muy pronto</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'cta__form' -%}
      <label class="visually-hidden" for="password">Contraseña</label>
      <input id="password" class="field" type="password" name="password" placeholder="Contraseña" autocomplete="current-password">
      <button class="btn btn--primary" type="submit">Entrar</button>
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

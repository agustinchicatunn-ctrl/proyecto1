<section class="section">
  <div class="container">
    <div class="section__head">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by 24 -%}
      <div class="grid grid--products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="muted">Todavía no hay productos en esta colección.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

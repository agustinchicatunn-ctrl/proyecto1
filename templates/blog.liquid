<section class="section">
  <div class="container">
    <div class="section__head"><h1>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 12 -%}
      <div class="grid grid--products">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            {%- if article.image -%}<div class="card__media">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
            <div class="card__body">
              <h3 class="card__title">{{ article.title }}</h3>
              <p class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

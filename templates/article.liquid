<article class="section">
  <div class="container container--narrow">
    <p class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }}</p>
    <h1>{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager' }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a class="link-arrow" href="{{ blog.url }}">&larr; Volver a {{ blog.title }}</a>
  </div>
</article>

<section class="section">
  <div class="container">
    <div class="section__head"><h1>Colecciones</h1></div>
    <div class="grid grid--products">
      {%- for collection in collections -%}
        <a class="card" href="{{ collection.url }}">
          <div class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="card__body"><h3 class="card__title">{{ collection.title }}</h3></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
